# Rust / host
host/target/
**/*.rs.bk
Cargo.lock.orig

# Theos / device build artifacts
device/.theos/
device/**/.theos/
device/obj/
device/**/obj/
device/packages/
device/**/*.deb
.theos/

# Generated Sileo/Zebra repo output
packaging/repo/out/

# macOS
.DS_Store

# Editor and local tooling state, not part of the project
.vscode/
.idea/
*.local.json

# Python cache
__pycache__/
*.pyc

# Private planning docs, never published.
priv-docs/

# Secrets. Never commit device credentials, keys, or session tokens.
*.pem
id_rsa*
*.token
secrets.env
.env

# Fork: unrelated reverse-engineering artifacts and build logs, never commit.
kwai-*
kwai-dump/
build*.log

# Packaged Windows release zips (uploaded to GitHub Releases, not committed).
ioscpy-windows-*.zip
